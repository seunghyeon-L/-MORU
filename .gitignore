# ─────────────────────────────────────
# 비밀 — 절대 커밋 금지
# ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
serviceAccount*.json

# ─────────────────────────────────────
# 저작권 — 팀 내부 참고용 자산
# App Store 공식 스크린샷. 공개 저장소에 올리지 않는다.
# 원본은 로컬 assets/refshots/ 에 보관하고,
# 재수집 방법은 docs/design-01-figma-and-system.md §5.2 참조
# ─────────────────────────────────────
assets/refshots/

# ─────────────────────────────────────
# 의존성 · 빌드 산출물
# ─────────────────────────────────────
node_modules/
venv/
.venv/
__pycache__/
*.py[cod]
dist/
build/
.expo/
*.apk
*.aab
*.ipa

# ─────────────────────────────────────
# 런타임 생성물
# ─────────────────────────────────────
uploads/
*.log
*.sqlite
*.db

# ─────────────────────────────────────
# 도구 · OS
# ─────────────────────────────────────
.omc/
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─────────────────────────────────────
# 개인정보 — 설문 원본
# 응답자에게 "제3자에게 제공되지 않습니다" 라고 고지했으므로
# 공개 저장소에 올리지 않는다. 팀 내부 드라이브로만 공유.
# ─────────────────────────────────────
docs/data/

# 비밀 파일을 압축해 전달할 때 실수로 커밋되는 것 방지
*.zip

# 로컬 실행 설정
.claude/

# 발표 준비 — 개인용. 저장소에 올리지 않는다
docs/present-*.html
