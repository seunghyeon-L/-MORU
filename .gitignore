# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# 세션 작업 중 생기는 백업
*.bak-*

# ══════════════════════════════════════════════════════════════
#  아래는 서버(main) 쪽 규칙. 두 저장소를 한 브랜치로 합치면서 가져왔다.
# ══════════════════════════════════════════════════════════════

# 비밀 — 절대 커밋 금지
.env.*
credentials.json
serviceAccount*.json
*.zip

# ★ 예외: 프론트엔드의 .env 는 일부러 커밋한다.
#   안에 EXPO_PUBLIC_API_BASE_URL(공개 서버 주소) 하나뿐이고 비밀이 없다.
#   팀원이 클론하자마자 앱이 서버에 붙게 하려면 여기 있어야 한다.
!.env
!.env.example

# 의존성 · 빌드 산출물
__pycache__/
*.py[cod]
.venv/
venv/
build/
*.apk
*.aab
*.ipa

# 런타임 생성물
*.log
*.db
*.sqlite
uploads/

# 도구 · OS
.idea/
.omc/
Thumbs.db

# 저작권 — 팀 내부 참고용 자산
# 원본은 로컬 assets/refshots/ 에 보관하고,
# 재수집 방법은 docs/design-01-figma-and-system.md §5.2 참조
assets/refshots/

# 개인정보 — 설문 원본
# 응답자에게 "제3자에게 제공되지 않습니다" 라고 고지했으므로
# 공개 저장소에 올리지 않는다. 팀 내부 드라이브로만 공유.
docs/data/

# 발표 준비 — 개인용
docs/present-*.html
